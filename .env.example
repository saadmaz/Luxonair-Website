# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.
# Add these same keys in Hostinger hPanel → Node.js → Environment Variables.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── Database ─────────────────────────────────────────────────────────────────
# Full MySQL connection URL. Format:
#   mysql://USERNAME:PASSWORD@HOST:PORT/DATABASE
# On Hostinger the host is usually 127.0.0.1 (the app and DB share the same server).
#
# ⚠️ DO NOT point local development at the production database. `npm run dev`,
# `npm run db:studio`, and the Playwright suite in tests/ all read this file, and
# will happily read/write real customer data if DATABASE_URL points at prod.
# For local dev, run `docker compose up -d` (see docker-compose.yml) and use:
#   DATABASE_URL=mysql://luxonair_dev:luxonair_dev_password@127.0.0.1:3306/luxonair_dev
DATABASE_URL=mysql://username:password@127.0.0.1:3306/dbname

# Set to "true" only if your MySQL/MariaDB server requires/supports TLS (uncommon
# for same-host Hostinger deployments where DATABASE_URL host is 127.0.0.1).
DATABASE_SSL=false

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate a secure random secret (minimum 32 bytes of hex):
#   openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# ─── Admin credentials ────────────────────────────────────────────────────────
# The username used to log in to the admin dashboard.
ADMIN_USERNAME=super_admin

# bcrypt hash of the admin password. Generate with:
#   node -e "require('bcryptjs').hash('yourpassword', 12).then(console.log)"
# Then paste the full $2b$... string here.
ADMIN_PASSWORD_HASH=$2b$12$replacethiswitharealbcrypthashofyourpassword

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Get your API key from resend.com → API Keys.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The "from" address — must be a verified domain in your Resend account.
# While testing you can use: onboarding@resend.dev (Resend's shared domain).
RESEND_FROM=Luxeonair <noreply@luxeonair.co.uk>

# Where notification emails are sent (your inbox).
RESEND_TO=admin@luxeonair.co.uk

# ─── Error monitoring (Sentry) ────────────────────────────────────────────────
# Optional. Create a project at sentry.io and paste the DSN here.
# If unset, errors are logged to console only.
SENTRY_DSN=
